#!/bin/bash
set -euo pipefail

region="${region}"
ssm_prefix="${ssm_prefix}"
api_image="${api_image}"
api_port="${api_port}"

mkdir -p /opt/mern/api

# Ensure SSM agent is running
systemctl enable --now amazon-ssm-agent

# Install Docker, Docker Compose plugin, and Nginx
if command -v dnf >/dev/null 2>&1; then
  dnf install -y docker docker-compose-plugin nginx awscli
else
  apt-get update -y
  apt-get install -y docker.io docker-compose-plugin nginx awscli
fi

systemctl enable --now docker

# Fetch secrets from SSM Parameter Store
mongo_uri=$(aws ssm get-parameter --name "${ssm_prefix}/MONGO_URI" --with-decryption --region "$region" --query "Parameter.Value" --output text)
jwt_access=$(aws ssm get-parameter --name "${ssm_prefix}/JWT_ACCESS_SECRET" --with-decryption --region "$region" --query "Parameter.Value" --output text)
jwt_refresh=$(aws ssm get-parameter --name "${ssm_prefix}/JWT_REFRESH_SECRET" --with-decryption --region "$region" --query "Parameter.Value" --output text)

cat > /opt/mern/api/.env <<EOF
MONGO_URI=${mongo_uri}
JWT_ACCESS_SECRET=${jwt_access}
JWT_REFRESH_SECRET=${jwt_refresh}
EOF

cat > /opt/mern/api/docker-compose.yml <<EOF
services:
  api:
    image: ${api_image}
    restart: always
    env_file:
      - /opt/mern/api/.env
    ports:
      - "127.0.0.1:${api_port}:${api_port}"
EOF

/usr/bin/docker compose -f /opt/mern/api/docker-compose.yml pull
/usr/bin/docker compose -f /opt/mern/api/docker-compose.yml up -d

cat > /etc/nginx/conf.d/mern-api.conf <<EOF
server {
  listen 80;

  location /health {
    proxy_pass http://127.0.0.1:${api_port}/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:${api_port}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
EOF

systemctl enable --now nginx
